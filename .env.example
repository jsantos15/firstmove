# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Used server-side only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Used by scripts/generate-opening-candidates.cjs for authenticated Lichess Explorer access
LICHESS_API_TOKEN=YOUR_LICHESS_PERSONAL_API_TOKEN

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── OAuth ───────────────────────────────────────────────────────────────────
# Google OAuth — configured in Supabase Auth → Providers → Google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
