# ─── Supabase ────────────────────────────────────────────────────────────────
# Found in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_LOCAL_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_TARGET=local

# Expo uses the computer's LAN address when testing on a physical device.
EXPO_PUBLIC_SUPABASE_URL=http://YOUR_COMPUTER_LAN_IP:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_LOCAL_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_SUPABASE_TARGET=local

# Used server-side only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Used by scripts/generate-opening-candidates.cjs for authenticated Lichess Explorer access
LICHESS_API_TOKEN=YOUR_LICHESS_PERSONAL_API_TOKEN

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── OAuth ───────────────────────────────────────────────────────────────────
# Google OAuth — configured in Supabase Auth → Providers → Google
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
