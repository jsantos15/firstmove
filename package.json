{
  "name": "firstmove",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@firstmove/web",
    "dev:mobile": "turbo run dev --filter=@firstmove/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\" --ignore-path .gitignore",
    "analyze:opening-line": "node scripts/analyze-opening-line.cjs",
    "generate:opening-candidates": "node scripts/generate-opening-candidates.cjs",
    "generate:opening-branches": "node scripts/generate-opening-branches.cjs",
    "dedup:opening-branches": "node scripts/dedup-opening-branches.cjs",
    "delete:opening-branches": "node scripts/delete-opening-branches.cjs",
    "pipeline:opening-course": "node scripts/run-opening-course-pipeline.cjs",
    "audit:opening-lines:lichess-cloud": "node scripts/audit-opening-lines-lichess-cloud.cjs",
    "test:coach": "node scripts/test-coach-contract.cjs",
    "merge:opening-candidates": "node scripts/merge-opening-candidates.cjs",
    "prepare:opening-db-payload": "node scripts/prepare-opening-db-payload.cjs",
    "import:opening-db-payload": "node scripts/import-opening-db-payload.cjs",
    "sync:opening-db-payload": "node scripts/sync-opening-db-payload.cjs",
    "build:opening-position-index": "node scripts/build-opening-position-index.cjs",
    "import:opening-position-index": "node scripts/import-opening-position-index.cjs",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.0",
    "prettier": "^3.3.0",
    "stockfish": "18.0.8",
    "turbo": "^2.3.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "dependencies": {
    "chess.js": "^1.4.0"
  }
}
